# Placeholders only. Copy to .env.local and replace before running.
# Supabase project Connect dialog / API settings: public values only.
# Never put a service-role JWT or sb_secret_ key in either NEXT_PUBLIC_ value.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Required in Production and Preview: the exact HTTPS origin of THAT deployment.
# No trailing path, query or fragment. Mirror it in Supabase Auth URL settings.
# Development defaults to localhost:3000 if omitted; production has no default.
SITE_URL=http://localhost:3000
